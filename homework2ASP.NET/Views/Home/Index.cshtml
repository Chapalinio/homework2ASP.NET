@{
    ViewData["Title"] = "Home Page";
}

<main>
    <section class="hero">
        <h1>Ласкаво прошу на сайт!</h1>
        <p>Тут ви знайдете колекцію моїх найулюбленіших ігор, фільмів та музичних альбомів.</p>
    </section>

    <section>
        <h2 style="margin-bottom: 20px;">Категорії</h2>
        <div class="grid">
            <div class="card">
                <img src="https://images.unsplash.com/photo-1550745165-9bc0b252726f?w=600" alt="Ігри">
                <div class="card-content">
                    <h3>Відеоігри</h3>
                    <p>Огляд найкращих віртуальних світів, інтерактивних історій та захоплюючих пригод.</p>
                </div>
            </div>

            <div class="card">
                <img src="https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=600" alt="Фільми">
                <div class="card-content">
                    <h3>Кінематограф</h3>
                    <p>Мої улюблені фільми та серіали, які залишили незабутній слід у пам'яті.</p>
                </div>
            </div>

            <div class="card">
                <img src="https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=600" alt="Музика">
                <div class="card-content">
                    <h3>Музика</h3>
                    <p>Альбоми та виконавці, чиї треки супроводжують мене щодня.</p>
                </div>
            </div>
        </div>
    </section>
</main>